# Library load path para o homebrew em M1 Macs atualizado com base na sugestão
# do aluno Matheus de Moraes Costa em 2022/2.

SOURCES := src/main.cpp src/course/correcao.cpp src/ui/textrendering.cpp \
           src/third_party/glad.c src/third_party/tiny_obj_loader.cpp src/third_party/stb_image.cpp \
           src/aircraft/Aircraft.cpp src/aircraft/FlightModel.cpp \
           src/camera/CameraController.cpp src/camera/CameraInput.cpp src/camera/MouseCapture.cpp \
           src/platform/FrameLimiter.cpp src/render/GameScene.cpp src/render/ModelRenderer.cpp \
           src/render/MaterialPolicy.cpp src/render/RenderInspection.cpp
HEADERS := $(wildcard include/*.h src/*/*.hpp)

./bin/macOS/main: $(SOURCES) $(HEADERS) Makefile.macOS
	mkdir -p bin/macOS
	g++ -std=c++11 -Wall -Wno-deprecated-declarations -Wno-unused-function -g -I ./include/ -I ./src/ -o ./bin/macOS/main $(SOURCES) -framework OpenGL -L/usr/local/lib -L/opt/homebrew/Cellar -lglfw -lm -ldl -lpthread

.PHONY: clean run
clean:
	rm -f bin/macOS/main

run: ./bin/macOS/main
	cd bin/macOS && ./main
